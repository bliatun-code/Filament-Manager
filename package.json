{
  "name": "bambu-filament-manager",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "doctor": "node ./scripts/doctor.mjs",
    "test:companion": "node ./scripts/run-companion-tests.mjs",
    "test:rust": "cargo test && cargo clippy --all-targets -- -D warnings",
    "test:settings-ui": "node ./node_modules/tsx/dist/cli.mjs --test ./ui/src/lib/clipboard.test.ts ./ui/src/lib/color_utils.test.ts ./ui/src/lib/date_time.test.ts ./ui/src/lib/spool_weight.test.ts ./ui/src/lib/trusted_lan_pairing_qr.test.ts ./ui/src/lib/filament_qr_payload.test.ts ./ui/src/lib/filament_label_print.test.ts ./ui/src/lib/inventory_overview_print.test.ts ./ui/src/lib/spool_sort.test.ts ./ui/src/lib/printer_profiles.test.ts ./ui/src/pages/settings_companion_model.test.ts ./ui/src/pages/settings_library_sync_model.test.ts",
    "smoke": "npm --prefix ./ui run build && npm run test:companion && npm run test:settings-ui && npm run doctor",
    "scrape": "node ./node_modules/tsx/dist/cli.mjs src/scraper/bambu_filament_scraper.ts",
    "scrape:auto": "node ./node_modules/tsx/dist/cli.mjs src/scraper/bambu_auto_scrape.ts",
    "scrape:safe": "npm run doctor && npm run scrape",
    "scrape:auto:safe": "npm run doctor && npm run scrape:auto",
    "tauri": "node ./scripts/run-tauri.mjs"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.6.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "tsx": "^4.7.0"
  }
}
