{
  "name": "bambu-filament-manager",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.21.1",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "doctor": "node ./scripts/doctor.mjs",
    "check:version": "node ./scripts/check-version-consistency.mjs",
    "check:github-actions-pinning": "node ./scripts/check-github-actions-pinning.mjs",
    "check:path-portability": "node ./scripts/check-path-portability.mjs",
    "check:seed-catalog": "node ./scripts/check-seed-catalog.mjs",
    "check:bambu-data": "node ./scripts/check-bambu-data.mjs",
    "check:printer-models": "node ./scripts/check-printer-models.mjs",
    "check:companion-routes": "node ./scripts/check-companion-routes.mjs",
    "check:companion-css-vars": "node ./scripts/check-companion-css-vars.mjs",
    "check:ui-css-vars": "node ./scripts/check-ui-css-vars.mjs",
    "check:css-vars": "npm run check:companion-css-vars && npm run check:ui-css-vars",
    "check:tauri-invokes": "node ./scripts/check-tauri-invokes.mjs",
    "check:ui-architecture": "node ./scripts/check-ui-architecture.mjs",
    "check:i18n-fallbacks": "node ./scripts/check-i18n-fallbacks.mjs",
    "check:i18n-locales": "node ./scripts/check-i18n-locales.mjs",
    "check:companion-i18n": "node ./scripts/check-companion-i18n.mjs",
    "check:i18n-ui-copy": "node ./scripts/check-i18n-ui-copy.mjs",
    "check:i18n-readiness": "node ./scripts/check-i18n-readiness.mjs",
    "report:i18n": "node ./scripts/check-i18n-readiness.mjs",
    "export:i18n-review": "node ./scripts/export-i18n-review.mjs",
    "check:ui-bundle-chunks": "node ./scripts/check-ui-bundle-chunks.mjs",
    "check:ui-orphans": "node ./scripts/check-ui-orphans.mjs",
    "check:contracts": "npm run check:version && npm run check:github-actions-pinning && npm run check:path-portability && npm run check:seed-catalog && npm run check:bambu-data && npm run check:printer-models && npm run check:tauri-invokes && npm run check:companion-routes && npm run check:css-vars && npm run check:ui-orphans && npm run check:ui-architecture && npm run check:i18n-fallbacks && npm run check:i18n-locales && npm run check:companion-i18n && npm run check:i18n-ui-copy && npm run check:i18n-readiness && npm run check:ui-bundle-chunks",
    "lint:ui": "npm --prefix ./ui run lint",
    "fmt:rust": "cargo fmt --all -- --check",
    "test:companion": "node ./scripts/run-companion-tests.mjs",
    "test:scripts": "node --test ./scripts/*.test.mjs",
    "test:portability": "npm run check:path-portability && node --test ./scripts/check-path-portability.test.mjs ./scripts/run-tauri.test.mjs ./scripts/visual-qa-db.test.mjs ./scripts/check-companion-css-vars.test.mjs",
    "test:rust": "npm run fmt:rust && cargo test && cargo clippy --all-targets -- -D warnings",
    "test:ui": "node ./scripts/run-ui-tests.mjs",
    "test:settings-ui": "npm run test:ui",
    "verify:macos-release": "node ./scripts/verify-macos-release.mjs",
    "smoke": "npm --prefix ./ui run build && npm run lint:ui && npm run test:companion && npm run test:scripts && npm run test:ui && npm run check:contracts && npm run doctor",
    "verify": "npm run smoke && npm run test:rust",
    "qa:visual:db": "node ./scripts/visual-qa-db.mjs",
    "qa:visual": "node ./scripts/run-visual-qa.mjs",
    "qa:visual:companion": "node ./scripts/run-companion-visual-gate.mjs",
    "qa:visual:companion:screens": "node ./scripts/run-companion-screenshot-gate.mjs",
    "qa:visual:companion:screens:launch": "node ./scripts/run-companion-screenshot-gate.mjs --launch",
    "qa:visual:desktop:screens": "node ./scripts/run-desktop-screenshot-gate.mjs",
    "qa:visual:desktop:scenarios": "node ./scripts/run-desktop-screenshot-gate.mjs --launch --scenario all",
    "scrape": "node ./node_modules/tsx/dist/cli.mjs src/scraper/bambu_filament_scraper.ts",
    "scrape:auto": "node ./node_modules/tsx/dist/cli.mjs src/scraper/bambu_auto_scrape.ts",
    "scrape:safe": "npm run doctor && npm run scrape",
    "scrape:auto:safe": "npm run doctor && npm run scrape:auto",
    "catalog:seed:export": "node ./scripts/export-seed-catalog.mjs",
    "tauri": "node ./scripts/run-tauri.mjs"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1"
  }
}
